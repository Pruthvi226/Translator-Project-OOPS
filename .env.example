# Copy to .env. Existing .env files are never overwritten automatically.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./fluentflow.db
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-this-to-a-random-secret-at-least-32-characters
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
PROVIDER_ORDER=gemini
ENABLE_DEEP_TRANSLATOR=false
ENABLE_NLLB=false
ENABLE_SPEECH=false
ENABLE_RAG=false
WHISPER_MODEL=base
PROVIDER_TIMEOUT=30
PROVIDER_RETRIES=1
RATE_LIMIT=30
MAX_UPLOAD_MB=10
RETENTION_DAYS=30
CORS_ORIGINS=http://localhost:5173
# Set current model prices to enable cost estimates.
# GEMINI_INPUT_USD_PER_MILLION=
# GEMINI_OUTPUT_USD_PER_MILLION=
POSTGRES_USER=fluentflow
POSTGRES_DB=fluentflow
POSTGRES_PASSWORD=
