# AI-Translator-Pro environment variables
# Copy to .env in backend/ or deployment/ and fill in production values.

# Required in production
SECRET_KEY=

# Database
MONGODB_URI=mongodb://mongo:27017
MONGODB_DB_NAME=translator_db

# CORS, comma-separated
CORS_ORIGINS=http://localhost:3000

# JWT
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Optional: OpenAI Whisper API for server-side speech-to-text
OPENAI_API_KEY=
USE_WHISPER_API=false
